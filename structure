
    <div id="product">
    <div class="big" id="pImg"></div>
    <div class="body">
      <h2 id="pName"></h2>
      <div class="price" id="pPrice"></div>
      <div class="qty" id="qty"></div>
      <div class="actions">
        <button id="addBtn">Add to order</button>
        <button id="cancelBtn">Cancel</button>
      </div>
    </div>
  </div>
  <div id="added"><span>✔</span>Added to order</div>


#product{position:fixed;inset:0;background:var(--bg);color:var(--text);display:none;flex-direction:column;z-index:10;overflow:auto}
#product.open{display:flex}
#product .big{height:38vh;min-height:200px;display:flex;align-items:center;justify-content:center;background:var(--card);border-bottom:1px solid var(--line)}
#product .big img{width:100%;height:100%;object-fit:cover}
#product .body{max-width:500px;width:100%;margin:0 auto;padding:18px;text-align:center}
#product h2{margin:0}
#product .price{color:var(--red);font-size:1.4rem;font-weight:700;margin:6px 0 16px}

/* przyciski z liczbami */
.qty{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:22px}
.qty button{width:48px;height:48px;border-radius:50%;border:2px solid var(--line);background:var(--card);color:var(--text);font-size:1.1rem;font-weight:700;cursor:pointer}
.qty button.sel{background:var(--yellow);border-color:var(--yellow);color:#222}

/* Add to order i Cancel */
.actions{display:flex;flex-direction:column;gap:10px}
.actions button{padding:14px;border-radius:12px;border:0;font-size:1.05rem;font-weight:700;cursor:pointer}
#addBtn{background:var(--red);color:#fff}
#cancelBtn{background:transparent;border:2px solid var(--line);color:var(--text)}

/* biały ekran "Added to order" */
#added{position:fixed;inset:0;background:#fff;color:#222;display:none;align-items:center;justify-content:center;flex-direction:column;z-index:20;font-size:2rem;font-weight:800}
#added.open{display:flex}
#added span{font-size:4rem;color:#1a9b3c}